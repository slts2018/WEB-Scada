# Server
HOST=0.0.0.0
PORT=8787

# MySQL（工程 / 发布包）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=web_scada
# MySQL 不可用时是否回退本地 JSON 文件
MYSQL_FALLBACK_FILE=true

# InfluxDB（Tag 时序）
INFLUX_URL=http://127.0.0.1:8086
# 与 docker-compose 初始化 token 一致；本机 Influx 未启动时服务仍可起
INFLUX_TOKEN=web-scada-dev-token
INFLUX_ORG=web-scada
INFLUX_BUCKET=tags
INFLUX_MEASUREMENT=tag_value
# true = Influx 连不上则拒绝启动
INFLUX_REQUIRED=false

# 最小 API 鉴权（阶段 F）
# 为空 = 关闭鉴权（本地 pnpm dev 默认）
# 设置后：写值 / 改库 / 工程变更 / 上传等需 Authorization: Bearer <token>
# 前端同步设置 VITE_SCADA_API_TOKEN（同值）
SCADA_API_TOKEN=
# true = 强制要求配置 Token，否则拒绝启动（生产可选）
SCADA_AUTH_REQUIRED=false
