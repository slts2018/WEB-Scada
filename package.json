{
  "name": "web-scada",
  "private": true,
  "version": "0.1.0",
  "description": "Web ???? ? Designer / Runtime?? 2D + 3D?",
  "scripts": {
    "dev": "pnpm --parallel --filter @web-scada/web --filter @web-scada/server-java dev",
    "dev:web": "pnpm --filter @web-scada/web dev",
    "dev:server": "pnpm --filter @web-scada/server-java dev",
    "dev:mysql": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/embedded-mysql.ps1 -Action Start",
    "dev:mysql:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/embedded-mysql.ps1 -Action Stop",
    "dev:influx": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/embedded-influx.ps1 -Action Start",
    "dev:influx:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/embedded-influx.ps1 -Action Stop",
    "build": "pnpm --filter @web-scada/web build",
    "preview": "pnpm --filter @web-scada/web preview",
    "typecheck": "pnpm -r typecheck",
    "pack:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pack-windows.ps1",
    "pack:win:java": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pack-windows.ps1 -IncludeJava",
    "pack:site": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pack-site.ps1",
    "pack:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pack-setup.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "vue-demi"]
  }
}
